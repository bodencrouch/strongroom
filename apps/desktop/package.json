{
  "version": "0.3.7",
  "private": true,
  "description": "Strongroom, a modern, unofficial Bitwarden client.",
  "homepage": "https://bodencrouch.github.io/strongroom/",
  "author": "Strongroom contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "desktopName": "strongroom.desktop",
  "name": "@strongroom/desktop",
  "scripts": {
    "dev": "node build/dev.mjs",
    "start": "electron .",
    "build": "vp run bundle",
    "typecheck": "vp lint src electron-builder.ts build vite.config.mjs",
    "package:mac": "vp run build && electron-builder --mac --arm64 --publish never",
    "package:linux": "vp run build && electron-builder --linux --publish never",
    "package:win": "vp run build && electron-builder --win --publish never",
    "package:autofill": "node build/package-autofill.mjs",
    "package:dir": "vp run build && electron-builder --mac dir --arm64 --publish never",
    "package:mac:signed": "node build/package-autofill.mjs --release"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.7.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.9.1",
    "electron-builder": "^26.18.0",
    "motion": "^14.6.0",
    "node-api-headers": "^1.9.0",
    "plist": "^5.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.19",
    "tw-animate-css": "^1.4.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "@strongroom/shared": "workspace:*"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
